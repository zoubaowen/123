# ============================================================
# AI XiaoBao Academy environment template
# Copy this file to .env.local or configure these values on the server.
# Never commit real secrets.
# ============================================================

# ==================== Required Secrets ====================

# Session and data encryption. Generate long random values for production.
JWE_SECRET=
ENCRYPTION_KEY=

# Runtime: production / development / desktop
# NODE_ENV=production

# First boot admin password. Production requires an explicit strong password.
# At least 12 characters, with uppercase, lowercase, and numbers.
# INITIAL_ADMIN_PASSWORD=

# Database provider: cloudbase / drizzle
# DB_PROVIDER=drizzle

# SQLite database path when DB_PROVIDER=drizzle
# DATABASE_PATH=data/app.db

# Server port
# PORT=3001

# Log level: debug / info / warn / error
# LOG_LEVEL=info

# ==================== Account System ====================

# Web auth providers, comma separated.
NEXT_PUBLIC_AUTH_PROVIDERS=local

# Unified Web + Desktop account backend.
# In commercial desktop builds, set this to your deployed Web/API origin.
# Example: https://api.ai-xiaobao.cn
# CENTRAL_AUTH_BASE_URL=
# XIAOBAO_CLOUD_API_URL=

# Shared secret for desktop local server to read/consume the same cloud credits.
# Set the same strong random value on the Web/API server and packaged desktop config.
# CENTRAL_ACCOUNT_SYNC_SECRET=

# Desktop auth mode.
# cloud = desktop login/register talks to the central Web/API account service.
# local = private development only.
DESKTOP_AUTH_MODE=cloud

# ==================== SMS (Tencent Cloud) ====================

# SDK AppID, signature and template id from Tencent Cloud SMS console.
# Required to actually deliver verification codes in production.
# TENCENT_SMS_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=

# Development placeholder mode. When enabled the verification code is not
# sent and is fixed to 123456 so the whole registration flow can be tested
# before real SMS credentials are configured. Never enable in production.
# SMS_MOCK=1

# ==================== Tencent CloudBase ====================

TCB_SECRET_ID=
TCB_SECRET_KEY=

# CloudBase environment ID
# TCB_ENV_ID=

# Default region
# TCB_REGION=ap-shanghai

# User environment provisioning mode: shared / isolated
# TCB_PROVISION_MODE=shared

# Optional isolated environment pool
# ENV_POOL_ENABLED=false
# ENV_POOL_SIZE=3

# ==================== CodeBuddy ====================

# Recommended for individual/business API access.
# Get it from Tencent CodeBuddy profile/API console.
# CODEBUDDY_API_KEY=
# CODEBUDDY_INTERNET_ENVIRONMENT=internal

# Enterprise OAuth mode.
# CODEBUDDY_CLIENT_ID=
# CODEBUDDY_CLIENT_SECRET=
# CODEBUDDY_OAUTH_ENDPOINT=https://copilot.tencent.com/oauth2/token

# Use SDK supportedModels when available.
# 默认实时读取 CodeBuddy 账号的可用模型；如需仅使用内置回退目录，可显式设为 0。
# CODEBUDDY_DYNAMIC_MODELS=0

# ==================== AIGC Providers ====================

# XiaoBao Runtime OpenAI-compatible text model. The runtime remains unavailable
# until the URL, key, model ID, project skills, database checkpoint repository,
# and production safety/usage adapters are all configured.
# XIAOBAO_MODEL_BASE_URL=https://provider.example/v1
# XIAOBAO_MODEL_HEALTHCHECK_URL=https://provider.example/health
# XIAOBAO_MODEL_API_KEY=
# XIAOBAO_MODEL_ID=
# XIAOBAO_MODEL_NAME=
# XIAOBAO_MODEL_TIMEOUT_MS=30000
# XIAOBAO_MODEL_CONTEXT_WINDOW=
# Comma-separated server-side allowlist for non-admin XiaoBao test tasks.
# XIAOBAO_TEST_TASK_IDS=
# Comma-separated server-side allowlist for non-admin XiaoBao rollout users (new tasks).
# XIAOBAO_TEST_USER_IDS=

# XiaoBao production content-safety review and integer credit pricing.
# Configure these only on the server; leave all placeholders empty in source control.
# XIAOBAO_TMS_SECRET_ID=
# XIAOBAO_TMS_SECRET_KEY=
# XIAOBAO_TMS_TOKEN=
# XIAOBAO_TMS_REGION=
# XIAOBAO_TMS_BIZ_TYPE=
# XIAOBAO_TMS_TIMEOUT_MS=
# XIAOBAO_MODEL_TOKENS_PER_CREDIT=
# XIAOBAO_MODEL_MAX_CREDITS_PER_TASK=

# Volcengine / Ark credentials. Configure only on the server.
# VOLCENGINE_ACCESS_KEY_ID=
# VOLCENGINE_SECRET_ACCESS_KEY=
# VOLCENGINE_REGION=cn-north-1
# VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_ARK_API_KEY=

# Tencent Cloud media/model capabilities.
# TENCENT_HUNYUAN_IMAGE_ENABLED=1
# TENCENT_HUNYUAN_VIDEO_ENABLED=1
# TENCENT_MPS_AUDIO_ENABLED=1

# ==================== Usage Limits ====================

MAX_MESSAGES_PER_DAY=50
MAX_SANDBOX_DURATION=300

# ==================== Credits & Pricing ====================

# User-facing credit price. 10 = RMB 0.10 per credit.
CREDIT_PRICE_CENTS=10

# New users get this one-time bonus after phone SMS registration succeeds.
CREDITS_SIGNUP_BONUS=20

# Default credit cost by feature. Tune after checking your real provider bill.
CREDITS_COST_CHAT=1
CREDITS_COST_TASK=10
CREDITS_COST_IMAGE=8
CREDITS_COST_MUSIC=30
CREDITS_COST_VIDEO=180

# Windows installer exposed by /api/download/win after deployment.
# Can point to an installer .exe or a portable .zip generated from win-unpacked.
# DOWNLOAD_WINDOWS_PATH=/opt/ai-xiaobao/public/downloads/AI-XiaoBao-Academy-Windows.zip

# ==================== OpenCode Runtime Optional ====================

# Override OpenCode CLI binary path.
# OPENCODE_BIN=

# DeepSeek official API key for the OpenCode runtime.
# Declared as the "deepseek" provider in .opencode/opencode.json.
# DEEPSEEK_API_KEY=

# ==================== Sandbox ====================

# Sandbox image configuration generated by init/deploy scripts.
# SANDBOX_IMAGE_URI=
# SANDBOX_IMAGE_TYPE=personal
# SANDBOX_IMAGE_REGISTRY_ID=
# SANDBOX_IMAGE_PORT=9000

# Workspace isolation: shared / isolated
WORKSPACE_ISOLATION=isolated

# Disable Vite native overlay in previews if platform banner is preferred.
# VITE_DEV_OVERLAY=false

# ==================== GitHub OAuth Optional ====================

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ==================== Git Archive Optional ====================

# GIT_ARCHIVE_REPO=
# GIT_ARCHIVE_USER=
# GIT_ARCHIVE_TOKEN=

# ==================== CORS ====================

# Comma separated allowed origins.
# ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:5174

# Comma separated auth callback domains.
# AUTH_DOMAINS=localhost:5173,localhost:5174

# Internal callback base URL for local agent runtime.
# ASK_USER_BASE_URL=http://127.0.0.1:3001

# ==================== Proxy Optional ====================

# http_proxy=
# https_proxy=

# XiaoBao sandbox tools (optional; absent = game stays unavailable)
# XIAOBAO_SANDBOX_URL=
# XIAOBAO_SANDBOX_SESSION_ID=
# XIAOBAO_SANDBOX_AUTH_TOKEN=
# XIAOBAO_SANDBOX_TIMEOUT_MS=

# XiaoBao media service (optional; absent = image/video/music tools are not assembled).
# The service must expose POST {url}/api/media/{image|video|music} and GET {url}/health.
# XIAOBAO_MEDIA_URL=
# XIAOBAO_MEDIA_AUTH_TOKEN=
# XIAOBAO_MEDIA_TIMEOUT_MS=

# Volcengine Ark media (图片/视频). Optional; absent = media tools are not assembled.
# When ARK_API_KEY is present it takes precedence over the generic media service above.
# ARK_API_KEY=
# XIAOBAO_VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# XIAOBAO_VOLC_IMAGE_MODEL=doubao-seedream-4-0-250828
# XIAOBAO_VOLC_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
# XIAOBAO_VOLC_TIMEOUT_MS=240000
# XIAOBAO_VOLC_POLL_INTERVAL_MS=5000
# XIAOBAO_VOLC_POLL_TIMEOUT_MS=900000

# XiaoBao vision understanding (optional; absent = image input stays rejected).
# Only enable this when XIAOBAO_MODEL_* points at a vision-capable model.
# XIAOBAO_VISION_ENABLED=true

# XiaoBao artifact storage (optional). Media URLs from Ark expire in ~24h; configuring these
# mirrors generated images/videos into your own COS bucket and hands students durable links.
# All four of SECRET_ID/SECRET_KEY/BUCKET/REGION are required, otherwise nothing is mirrored.
# XIAOBAO_ARTIFACT_COS_SECRET_ID=
# XIAOBAO_ARTIFACT_COS_SECRET_KEY=
# XIAOBAO_ARTIFACT_COS_BUCKET=
# XIAOBAO_ARTIFACT_COS_REGION=
# XIAOBAO_ARTIFACT_COS_PREFIX=xiaobao-artifacts
# XIAOBAO_ARTIFACT_COS_DOMAIN=
# XIAOBAO_ARTIFACT_COS_TIMEOUT_MS=60000

# XiaoBao per-student credit budget (optional). Absent = no budget limit (today's behaviour).
# Once a student's settled credits reach the cap, starting a new task is refused with a static
# message. Malformed values disable budgeting entirely (a static warning is logged at startup).
# XIAOBAO_BUDGET_DEFAULT_CREDITS=200
# XIAOBAO_BUDGET_USER_CREDITS=student-a=50,student-b=100
