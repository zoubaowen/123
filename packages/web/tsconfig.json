{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@ai-xiaobao/shared": ["../shared/src/index.ts"],
      "@ai-xiaobao/chat-core": ["../chat-core/src/index.ts"],
      "@ai-xiaobao/dashboard/storage": ["../dashboard/src/services/storage.ts"],
      "@ai-xiaobao/dashboard/CloudDashboard": ["../dashboard/src/CloudDashboard.tsx"],
      "@ai-xiaobao/dashboard/*": ["../dashboard/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "../dashboard/src"]
}
