{
  "name": "ai-xiaobao-academy",
  "productName": "AI小宝学院",
  "version": "1.1.0",
  "description": "AI小宝学院 - 青少年 AI 编程创作伙伴",
  "author": "AI小宝学院",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @ai-xiaobao/web dev",
    "dev:playground": "pnpm --filter @ai-xiaobao/chat-playground dev",
    "dev:server": "pnpm --filter @ai-xiaobao/server dev",
    "dev:electron": "node electron/dev-runner.cjs",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "pnpm --filter @ai-xiaobao/web build",
    "build:playground": "pnpm --filter @ai-xiaobao/chat-playground build",
    "build:server": "pnpm --filter @ai-xiaobao/server build",
    "prepare:electron-server": "node scripts/prepare-electron-server.mjs",
    "rebuild:electron-native": "electron-rebuild -f -w better-sqlite3 -m .electron/server-packaged",
    "icons:export": "electron scripts/export-desktop-icons.cjs",
    "build:electron": "pnpm build && pnpm prepare:electron-server && pnpm rebuild:electron-native && node scripts/build-electron-app.mjs",
    "start": "pnpm --filter @ai-xiaobao/server start",
    "electron:start": "electron .",
    "lint": "eslint",
    "type-check": "tsc --noEmit && pnpm -r exec tsc -p tsconfig.json --noEmit && pnpm --dir packages/server/deploy exec tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "setup:tcr": "node scripts/setup-tcr.mjs",
    "deploy:cloud": "node scripts/deploy.mjs",
    "opencode:setup": "node scripts/opencode-setup.mjs",
    "codebuddy:setup": "node scripts/codebuddy-setup.mjs",
    "prepare": "husky",
    "build:electron-server": "node scripts/build-electron-server.mjs"
  },
  "devDependencies": {
    "@cloudbase/manager-node": "^4.10.6",
    "@cloudbase/node-sdk": "^3.18.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/ms": "^2.1.0",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.36.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "opencode-ai": "1.17.10",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tencentcloud-sdk-nodejs": "^4.1.205",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.ai-xiaobao.academy",
    "productName": "AI小宝学院",
    "copyright": "Copyright © 2026 AI小宝学院",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "packages/web/dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".electron/server-packaged",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/web/dist",
        "to": "web/dist"
      },
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/opencode-ai/bin",
        "to": "server/node_modules/opencode-ai/bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "signAndEditExecutable": false,
      "publisherName": "AI小宝学院",
      "executableName": "AI-XiaoBao-Academy",
      "artifactName": "AI-XiaoBao-Academy-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "license": "LICENSE"
    },
    "publish": {
      "provider": "generic",
      "url": "https://releases.ai-xiaobao.cn/desktop/"
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "pnpm": {
    "patchedDependencies": {
      "@tencent-ai/agent-sdk@0.3.68": "patches/@tencent-ai__agent-sdk@0.3.68.patch"
    },
    "onlyBuiltDependencies": [
      "opencode-ai",
      "electron",
      "node-pty",
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}